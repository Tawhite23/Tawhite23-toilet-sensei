#!/bin/sh
# public/data 配下は GitHub Actions の bot が管理する「生きたデータ」で、
# ローカルの内容は常に古くなりうる（フェッチ/ビルドを手元で試した残り、または
# 単に bot の最新コミットをまだ pull していないだけ）。これを他の変更と一緒に
# コミットしてしまうと、bot が更新した最新データを古い内容で上書きしてしまう。
#
# ★以前はここで自動的に git reset してコミットから静かに除外していたが、
#   GitHub Desktop のようなGUIだと「なぜかコミットしてもファイルが消えない」と
#   分かりにくく混乱を招いた。そのため、含まれている場合はコミット自体を拒否して
#   理由を表示する方式にした（GitHub Desktopはフック失敗時にこのメッセージを
#   エラーダイアログで表示する）。
#
# ★重要: これは「開発者がローカルで誤って古いデータをコミットしてしまう」事故を防ぐための
#   フックであり、bot(GitHub Actions)自身が public/data を更新するコミットまで妨げてはいけない。
#   CI環境（GitHub Actionsは CI=true を自動設定）では即座に何もせず終了する。
if [ -n "$CI" ] || [ -n "$GITHUB_ACTIONS" ]; then
  exit 0
fi

# ★重要: merge/rebase の完了コミット（例: origin の bot 更新を pull で取り込む場合）でも
#   pre-commit は発火する。ここで public/data を理由に弾いてしまうと、
#   bot の最新データを取り込む pull/merge そのものが完了できなくなってしまうため、
#   merge/rebase 進行中は常に許可する（このガードが無いと「Continue merge」がブロックされる）。
GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
if [ -f "$GIT_DIR/MERGE_HEAD" ] || [ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ]; then
  exit 0
fi

staged=$(git diff --cached --name-only -- public/data)
if [ -n "$staged" ]; then
  echo "public/data 配下のファイルがコミットに含まれているため、コミットを中止しました:"
  echo "$staged" | sed 's/^/  /'
  echo ""
  echo "public/data は GitHub Actions の bot が自動更新するデータです。通常は手元でコミットする必要はありません。"
  echo ""
  echo "・含めたくない場合: GitHub Desktopの変更一覧でこれらのファイルのチェックを外してから、再度コミットしてください。"
  echo "・意図的にこのデータをコミットしたい場合: ターミナルで 'npm run unprotect-data' を実行してから、もう一度コミットしてください。"
  exit 1
fi
exit 0
